{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(netstat *)",
      "Bash(taskkill *)",
      "WebFetch(domain:supadata.ai)",
      "WebFetch(domain:apify.com)",
      "WebFetch(domain:docs.supadata.ai)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  }
}
